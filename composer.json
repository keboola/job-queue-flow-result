{
    "name": "keboola/job-queue-flow-result",
    "type": "library",
    "license": "MIT",
    "description": "Conditional Flow result objects (data model) shared by the job queue daemon and flow layers",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Keboola\\JobQueue\\FlowResult\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keboola\\JobQueue\\FlowResult\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "keboola/job-queue-internal-api-php-client": "dev-sykorajiri-AJDA-563-client"
    },
    "require-dev": {
        "keboola/coding-standard": ">=15.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "tests": "phpunit",
        "phpstan": "phpstan analyse --no-progress -c phpstan.neon",
        "phpcs": "phpcs -n --extensions=php src tests",
        "phpcbf": "phpcbf -n --extensions=php src tests",
        "check": [
            "@phpcs",
            "@phpstan",
            "@tests"
        ],
        "ci": [
            "@composer validate --no-check-all --strict",
            "@check"
        ]
    },
    "config": {
        "lock": false,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
